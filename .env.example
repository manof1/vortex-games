# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE CONFIGURATION (Obter em: Supabase -> Project Settings -> API)
# ==============================================================================
# URL da sua instância Supabase (pública)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"

# Chave pública anon (pode ser exposta no frontend)
VITE_SUPABASE_ANON_KEY="sua_chave_anon_publica"

# Chave secreta de serviço (Service Role) - APENAS na Vercel (Environment Variables)
# NUNCA exponha esta chave no frontend!
SUPABASE_SERVICE_ROLE_KEY="sua_chave_service_role_secreta"

# ==============================================================================
# IGDB & TWITCH API (Obter em: dev.twitch.tv/console -> Register Your Application)
# ==============================================================================
TWITCH_CLIENT_ID="seu_twitch_client_id"
TWITCH_CLIENT_SECRET="seu_twitch_client_secret"

# ==============================================================================
# VERCEL CRON SECURITY (Opcional - Protege o endpoint /api/cron-sync)
# ==============================================================================
CRON_SECRET="sua_chave_secreta_para_o_cron"

